{
  "manifest_version": 3,
  "name": "Disable JavaScript - JS Switch per site",
  "version": "2.0.0",
  "description": "One-click toggle to enable or disable JavaScript per website. Lightweight, fast, and private.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "88",
  "homepage_url": "https://manikandanramar.com/projects/disable-javascript/",
  "permissions": ["tabs", "contentSettings", "contextMenus", "storage"],
  "background": {
    "service_worker": "js/main.js"
  },
  "action": {
    "default_icon": "icons/icon-enabled.png"
  }
}
